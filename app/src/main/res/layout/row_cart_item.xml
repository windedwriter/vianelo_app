<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/black"
    app:strokeWidth="1dp">

    <!-- CONTENIDO SUPERIOR -->
    <LinearLayout
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- COLUMNA IMAGEN + SUBTOTAL -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvSubtotal"
                android:text="$75.00"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- INFO PRODUCTO -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvName"
                android:text="Latte Vainilla"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- STEPPER -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_stepper"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnMinus"
                style="?attr/borderlessButtonStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/remove_24px"
                android:contentDescription="menos" />

            <TextView
                android:id="@+id/tvQty"
                android:text="1"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:textColor="@color/black" />

            <ImageButton
                android:id="@+id/btnPlus"
                style="?attr/borderlessButtonStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/add_24px"
                android:contentDescription="más" />
        </LinearLayout>
    </LinearLayout>

    <!-- FILA INFERIOR: SOLO ELIMINAR -->
    <LinearLayout
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="end">

        <TextView
            android:id="@+id/btnRemove"
            android:text="Eliminar"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
